# Copy this file to .env for local development (never commit the real .env),
# or set these as Environment Variables in your Vercel project settings.
# Required for POST /api/identify-sneaker to work outside the Claude artifact.

# Secret key from https://console.anthropic.com — server-side only, never
# exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 (current vision-capable model) if unset.
ANTHROPIC_MODEL=
